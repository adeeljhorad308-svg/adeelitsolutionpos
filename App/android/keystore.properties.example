# Copy this file to "keystore.properties" (same folder) and fill in your real
# values. NEVER rename/commit the real "keystore.properties" to git, email it,
# or paste it into any chat, including this one.
#
# storeFile   = path to your .jks file, relative to this "android" folder.
#               Keeping the jks OUTSIDE the project folder entirely (e.g. one
#               level up, or in a password manager's file storage) is safer
#               than keeping it inside the repo even if gitignored.
# storePassword = the password you set when running keytool -genkeypair
# keyAlias      = the -alias value you used with keytool
# keyPassword   = usually the same as storePassword unless you set it separately

storeFile=../../adeel-pos-release.jks
storePassword=REPLACE_ME
keyAlias=adeelpos
keyPassword=REPLACE_ME
